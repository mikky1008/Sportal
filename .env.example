# ---- Database (API) ---------------------------------------------------------
# PostgreSQL connection string. On Vercel this is set for you when you connect a Neon database
# (Storage tab). Locally, use a free Neon database, Supabase, or Docker:
#   docker run -d --name sportal-pg -p 5432:5432 -e POSTGRES_PASSWORD=pw -e POSTGRES_DB=sportal postgres:16
#   DATABASE_URL=
# ---- App (Vite) -------------------------------------------------------------
# WEB ON VERCEL: leave VITE_API_URL unset. The app calls /api/... on its own domain.
# LOCAL DEV (npm run dev + npm run api): http://localhost:8787 is used automatically.
# NATIVE APP (Capacitor) or an API hosted elsewhere: set it to the API's full URL.
#   Android emulator -> http://10.0.2.2:8787     iOS simulator -> http://localhost:8787
#   real device      -> https://your-app.vercel.app
VITE_API_URL=
# Optional: the AI video-analysis service. Leave empty to use the simulated results.
VITE_AI_API_URL=

# ---- Local API server (npm run api) -----------------------------------------
PORT=8787
# Extra origins allowed to call the API (comma separated). The Capacitor origins are built in,
# and the web app on Vercel is same-origin so it needs no entry.
CORS_ORIGINS=
# Set to true only when the local server runs behind a proxy you control (Vercel is detected).
TRUST_PROXY=false
